<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/ayahflow_widget_bg">
    <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#A7AD9F" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp" android:gravity="bottom">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/widget_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#D9BB79" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.12" android:text="NEXT PRAYER" />
            <TextView android:id="@+id/widget_prayer" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#F3F0E7" android:textSize="26sp" android:fontFamily="serif" android:maxLines="1" android:text="—" />
            <Chronometer android:id="@+id/widget_countdown" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#A7AD9F" android:textSize="12sp" android:countDown="true" />
        </LinearLayout>
        <TextView android:id="@+id/widget_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#EFDCAD" android:textSize="22sp" android:fontFamily="serif" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" android:background="#32362B" />
    <LinearLayout android:id="@+id/widget_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
        <TextView android:id="@+id/widget_p0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:textColor="#A7AD9F" android:textSize="10sp" android:maxLines="2" />
        <TextView android:id="@+id/widget_p1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:textColor="#A7AD9F" android:textSize="10sp" android:maxLines="2" />
        <TextView android:id="@+id/widget_p2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:textColor="#A7AD9F" android:textSize="10sp" android:maxLines="2" />
        <TextView android:id="@+id/widget_p3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:textColor="#A7AD9F" android:textSize="10sp" android:maxLines="2" />
        <TextView android:id="@+id/widget_p4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:textColor="#A7AD9F" android:textSize="10sp" android:maxLines="2" />
    </LinearLayout>
    <TextView android:id="@+id/widget_later" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textColor="#A7AD9F" android:textSize="11sp" android:maxLines="2" />
    <TextView android:id="@+id/widget_moment" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp"
        android:background="@drawable/ayahflow_widget_chip" android:textColor="#101411" android:textSize="11sp" android:textStyle="bold" android:visibility="gone" />
</LinearLayout>
